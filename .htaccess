Options -Indexes

# Only index.php at / — do not fall through to index.html (bypasses auth)
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the site lives in a subfolder, uncomment:
    # RewriteBase /

    RewriteRule ^sql/        - [F,L]
    RewriteRule ^includes/   - [F,L]

    # Assets and robots.txt served directly
    RewriteRule ^assets/     - [L]
    RewriteRule ^robots\.txt$ - [L]

    # Block direct access to router.php
    RewriteRule ^router\.php$ - [F,L]

    # PHP files must execute via the native PHP handler — do NOT route through router.php.
    # Per-file [L] rules (login.php, logout.php, etc.) caused Hostinger/LiteSpeed to serve
    # PHP files via the static handler, which downloads them instead of executing them.
    RewriteCond %{REQUEST_URI} \.php$ [NC]
    RewriteRule ^ - [L]

    # All other paths (including .html) go through the auth router
    RewriteRule ^ router.php [L,QSA]
</IfModule>

<Files ".env">
    Require all denied
</Files>

<FilesMatch "\.(sql)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType audio/mp4 .m4a
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>
