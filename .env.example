# ERC Housing Digital Transformation portal — environment configuration
# Copy to .env and adjust. Uses the same MySQL users table as sor-system.
#
# Local (php -S with router):
#   php -S localhost:8080 router.php
#
# ─── LOCAL ───────────────────────────────────────────────────
APP_ENV=local
APP_URL=http://localhost:8080
DB_HOST=localhost
DB_PORT=8889
DB_NAME=sor_management
DB_USER=root
DB_PASS=root
SESSION_SECRET=change_this_secret_in_production
#
# ─── Microsoft Entra ID (optional — same as sor-system) ─────
# Requires: composer install && Entra redirect URI for this site
# ENTRA_ENABLED=false
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=
# ENTRA_ALLOWED_ROLES=SOR.Admin,SOR.Editor,SOR.Viewer
#
# ─── HOSTINGER (production) ──────────────────────────────────
# APP_ENV=production
# APP_URL=https://aqua-quetzal-992173.hostingersite.com
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=u248320297_eastren
# DB_USER=u248320297_eastren
# DB_PASS=your_db_password_from_hpanel
# SESSION_SECRET=use_a_long_random_string_here
